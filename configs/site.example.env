# Site configuration for QLM-Bench. Copy to configs/site.env, edit, then `set -a; . configs/site.env; set +a`.
# Every variable here is read by the code; these are the only places that name repositories or local paths.

# Hugging Face dataset with demonstrations, Standard100 suite, scene packs and the train reset pool
QLM_DATASET_REPO=AIGeeksGroup/QLM-Bench
QLM_DATASET_REVISION=release

# Training-environment render mode: full (default) or sampled (accelerated, same policy frames)
QLM_RENDER_MODE=full

# Demonstration synthesis: external inputs that are not bundled (reference runs, scene sources).
# The bundled approved executors/references are found automatically (override: QLM_SYNTHESIS_REFERENCES).
# QLM_SYNTHESIS_WORKSPACE=/path/to/synthesis-inputs

# Standard100 three-seed script: attempts per seed when trials end with infrastructure errors
QLM_MAX_ATTEMPTS=3
